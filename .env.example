# Override credentials at runtime (otherwise read from OS keychain).
# Run `serverpilot-mcp setup` for the canonical setup flow.
SERVERPILOT_CLIENT_ID=cid_xxxxxxxxxxxx
SERVERPILOT_API_KEY=your_api_key_here

# Optional tuning.
SP_SSH_KEY_PATH=~/.ssh/serverpilot-mcp
SP_SSH_KEY_NAME=claude-mcp-serverpilot
SP_CACHE_TTL_SECONDS=300
SP_SSH_TIMEOUT_MS=30000
